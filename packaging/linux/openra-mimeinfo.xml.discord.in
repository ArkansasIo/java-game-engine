<?xml version="1.0"?>
<mime-info xmlns='http://www.freedesktop.org/standards/shared-mime-info'>
  <mime-type type="x-scheme-handler/Arklight-{MODID}-{TAG}">
    <icon name="Arklight-{MODID}" />
    <generic-icon name="applications-games"/>
    <comment>Join Arklight server</comment>
    <glob weight="60" pattern="Arklight-{MODID}-{TAG}://*"/>
  </mime-type>
  <mime-type type="x-scheme-handler/discord-{DISCORDAPPID}">
    <generic-icon name="applications-games"/>
    <comment>Launch Arklight from Discord</comment>
    <glob weight="60" pattern="discord-{DISCORDAPPID}://*"/>
  </mime-type>
</mime-info>

