[Desktop Entry]
Type=Application
Version=1.0
Name=Arklight - {MODNAME}
GenericName=Real Time Strategy Game
GenericName[de]=Echtzeit-Strategiespiel
Icon=Arklight-{MODID}
Exec=Arklight-{MODID} %U
Terminal=false
Categories=Game;StrategyGame;
StartupWMClass=Arklight-{MODID}-{TAG}
MimeType=x-scheme-handler/Arklight-{MODID}-{TAG};x-scheme-handler/discord-{DISCORDAPPID};

