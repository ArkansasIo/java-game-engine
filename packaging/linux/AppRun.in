#!/bin/sh
set -o errexit || exit $?

LAUNCHER=$(readlink -f "${0}")
HERE=$(dirname "${LAUNCHER}")

# Run the game or server
if [ -n "$1" ] && [ "$1" = "--server" ]; then
	# Drop the --server argument
	shift
	"${HERE}/usr/bin/Arklight-{MODID}-server" "$@"
elif [ -n "$1" ] && [ "$1" = "--utility" ]; then
	# Drop the --utility argument
	shift
	"${HERE}/usr/bin/Arklight-{MODID}-utility" "$@"
else
	"${HERE}/usr/bin/Arklight-{MODID}" "$@"
fi

